# Eco-teach environment variables
#
# v1 needs no environment variables: the app is static and progress is stored in the browser.
# Copy this file to .env.local for local development when variables are added.
# Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.
#
# Future (accounts & saved progress):
# AUTH_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# DATABASE_URL=
